# ---- Server-only. Never prefix these with NEXT_PUBLIC_. Put them in .env.local or your host's secret store. ----

# 0x… private key of the oracle: its ADDRESS must be the contract's azureOracleSigner. Generate a FRESH key; never reuse one
# that has appeared in a chat, a commit or a screenshot.
ORACLE_PRIVATE_KEY=
# Deployed MissionEV contract (falls back to NEXT_PUBLIC_MEV_CONTRACT_ADDRESS) and a JSON-RPC endpoint for Portal V3.
MISSIONEV_CONTRACT_ADDRESS=
PORTAL_RPC_URL=
# Azure AI Vision resource for ride-receipt OCR (optional; without it the receipt is entered by hand).
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
# Optional tuning: signature lifetime in seconds (default 600, max 3600) and signed journeys per commuter per UTC day (default 8).
ORACLE_SIGNATURE_TTL_SECONDS=
ORACLE_MAX_TRIPS_PER_DAY=

# ---- Public (visible in the browser) ----

# The deployed contract address is public by nature. Without it the app stays in DEMO.
NEXT_PUBLIC_MEV_CONTRACT_ADDRESS=
# Lets the wallet ADD Portal V3 (chain 420420777) when it isn't configured. Fill from the official Portal documentation.
NEXT_PUBLIC_PORTAL_RPC_URL=
NEXT_PUBLIC_PORTAL_CURRENCY_SYMBOL=
NEXT_PUBLIC_PORTAL_EXPLORER_URL=

# Optional map keys. A NEXT_PUBLIC_ key is visible to every visitor: restrict it by HTTP referrer in the provider's console.
# Google: enable "Maps JavaScript API", turn billing on, restrict to your domain and http://localhost:3000/*. Takes priority over Azure and OSM.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_AZURE_MAPS_KEY=
