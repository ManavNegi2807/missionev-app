# Copy to .env.local (git-ignored). Public values below are the real Portal V3 testnet deployment; every secret is left blank.

# ---- Server-only. Never prefix these with NEXT_PUBLIC_. Put them in .env.local or your host's secret store. ----

# 0x… private key of the verifier node (the oracle signer). Its ADDRESS must be the contract's oracle signer, which for the
# deployed contract is 0x2aD67FaC8dB8fF3255bA650639049020420160De. Generate a FRESH key; never reuse one that has appeared in
# a chat, a commit or a screenshot. Without it the app stays in DEMO and /api/sign-trip signs nothing.
ORACLE_PRIVATE_KEY=
# Deployed MissionEVv2 contract (falls back to NEXT_PUBLIC_MEV_CONTRACT_ADDRESS) and a JSON-RPC endpoint for Portal V3.
MISSIONEV_CONTRACT_ADDRESS=0x0904244017324dc1bf7c611fe1236936ee65fc82
PORTAL_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
# Optional tuning: signature lifetime in seconds (default 600, max 3600) and signed journeys per commuter per UTC day (default 8).
ORACLE_SIGNATURE_TTL_SECONDS=
ORACLE_MAX_TRIPS_PER_DAY=

# Receipt OCR needs no setting: Tesseract.js runs in the browser (the engine loads from a public CDN on first use).

# ---- Public (visible in the browser) ----

# The deployed contract address is public by nature. Without it the app stays in DEMO.
NEXT_PUBLIC_MEV_CONTRACT_ADDRESS=0x0904244017324dc1bf7c611fe1236936ee65fc82
# Lets the wallet ADD Portal V3 (chain 420420777) when it isn't configured.
NEXT_PUBLIC_PORTAL_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
NEXT_PUBLIC_PORTAL_CURRENCY_SYMBOL=tPOT
NEXT_PUBLIC_PORTAL_EXPLORER_URL=

# Optional Google Maps override. The default map is Leaflet on OpenStreetMap and needs no key. A NEXT_PUBLIC_ key is visible
# to every visitor: restrict it by HTTP referrer in the provider's console (enable "Maps JavaScript API", turn billing on,
# restrict to your domain and http://localhost:3000/*).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
